# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de Variables de Entorno
# ESTE ARCHIVO SÍ SE PUEDE SUBIR A GITHUB (No pongas contraseñas reales aquí)
# Instrucciones: Copia este archivo, renómbralo a ".env" y llena los valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5433/NOMBRE_BD"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL="redis://:PASSWORD@localhost:6379"

# ── JWT (Reemplazar con llaves generadas localmente) ─────────────────────────
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── NextAuth / SSO ────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar_un_secreto_aleatorio_con_openssl"

# Google OAuth2 (SSO provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OTP / TOTP ────────────────────────────────────────────────────────────────
OTP_ISSUER="BoutiqueHotels"
OTP_DIGITS="6"
OTP_PERIOD="30"
OTP_PEPPER="generar_un_hash_aleatorio_aqui"

# ── Storage (MinIO for dev / S3 for prod) ────────────────────────────────────
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="boutique-hotels-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_REGION="us-east-1"

# ── Google Maps ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── i18n ─────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE="es"
SUPPORTED_LOCALES="es,en"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
